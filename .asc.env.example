# Copy to .asc.env (git-ignored) and fill in. Used by scripts/apple-release.sh.
# See docs/app-store/ASC-上架手冊.md, steps 3 and 6, for where each value comes from.

# developer.apple.com → Account → Membership details → Team ID (10 characters)
APPLE_TEAM_ID=XXXXXXXXXX

# App Store Connect → Users and Access → Integrations → App Store Connect API → Team Keys
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Keep the .p8 outside the repository; it can only be downloaded once.
ASC_KEY_PATH=/Users/you/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Optional: must match frontend/capacitor.config.ts appId
# BUNDLE_ID=io.github.hauchiehlinops.omniseam3d
